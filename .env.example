# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/askdocs

# Redis
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=change-me-to-a-random-32-char-secret

# LLM Provider: openai | groq | gemini | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# OpenAI
OPENAI_API_KEY=

# Groq
GROQ_API_KEY=

# Gemini
GEMINI_API_KEY=

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# Embedding
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# RAG Settings
CHUNK_SIZE=512
CHUNK_OVERLAP=64
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6
TOP_K_RETRIEVAL=20
TOP_K_FINAL=5
MAX_FILE_SIZE_MB=50

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Upload directory
UPLOAD_DIR=uploads
